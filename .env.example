DB_NAME=canhotos
DB_USERNAME=canhotos
DB_PASSWORD=
DB_PORT=5432
APP_PORT=8080

# Autenticação (obrigatórias no docker compose)
# Segredo do JWT: pelo menos 32 caracteres aleatórios, ex.: openssl rand -base64 48
JWT_SECRET=
# Validade do token (ISO-8601: PT1H = 1 hora)
JWT_EXPIRACAO=PT1H
# Primeiro ADMIN, criado na subida se ainda não houver nenhum (senha com pelo menos 8 caracteres)
ADMIN_LOGIN=admin
ADMIN_NOME=Administrador
ADMIN_SENHA=

# Limite de tentativas de login: falhas permitidas por login e por IP dentro da janela (ISO-8601)
LOGIN_MAX_FALHAS_POR_LOGIN=5
LOGIN_MAX_FALHAS_POR_IP=20
LOGIN_JANELA=PT15M
